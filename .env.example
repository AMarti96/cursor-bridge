# Required: your Cursor API key (get it from https://cursor.com → Settings → API Keys)
CURSOR_API_KEY=your_cursor_api_key_here

# Default working directory for requests without a named workspace
CURSOR_CWD=/path/to/your/default/project

# Optional: port (default: 8765)
# PORT=8765

# Optional: resolve short command names to absolute paths (useful when running as
# a system service where PATH is stripped). Add one per command you need to resolve.
# BRIDGE_CMD_uvx=/home/youruser/.local/bin/uvx
# BRIDGE_CMD_npx=/usr/local/bin/npx
